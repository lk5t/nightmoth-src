{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nightmoth",
  "version": "0.1.0",
  "identifier": "dev.lk5t.nightmoth",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Nightmoth",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#0A0A0B"
      },
      {
        "label": "toast",
        "title": "Nightmoth",
        "url": "toast.html",
        "width": 380,
        "height": 104,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "lk5t",
    "shortDescription": "Desktop glow-up and autopilot optimizer",
    "longDescription": "Nightmoth themes Windows around your wallpaper and keeps your PC fast from the system tray.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  }
}
